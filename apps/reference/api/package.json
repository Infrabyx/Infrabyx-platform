{
  "name": "@infrabyx/reference-api",
  "version": "0.0.0",
  "description": "The reference API of apps/reference (PL6 plan §8): a NestJS 11 modular monolith on the @infrabyx/* packages with the hello module, the sign-in flow, the gate endpoints (content, Vidhi, export, trust) and the worker entrypoint; the template products copy",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./worker-main": {
      "types": "./dist/worker-main.d.ts",
      "default": "./dist/worker-main.js"
    },
    "./seed": {
      "types": "./dist/seed/hello.d.ts",
      "default": "./dist/seed/hello.js"
    },
    "./package.json": "./package.json",
    "./seed-adapters": {
      "types": "./dist/seed/adapters.d.ts",
      "default": "./dist/seed/adapters.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker-main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@infrabyx/ai": "workspace:*",
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/brand": "workspace:*",
    "@infrabyx/cms": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/connectors": "workspace:*",
    "@infrabyx/consent": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/export": "workspace:*",
    "@infrabyx/feedback": "workspace:*",
    "@infrabyx/hlp": "workspace:*",
    "@infrabyx/notify": "workspace:*",
    "@infrabyx/rules": "workspace:*",
    "@infrabyx/seed": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@infrabyx/testing": "workspace:*",
    "@infrabyx/trust": "workspace:*",
    "@infrabyx/vidhi": "workspace:*",
    "@infrabyx/workflow": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
