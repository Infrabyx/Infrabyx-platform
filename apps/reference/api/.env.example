############################################################
# Infrabyx <PRODUCT> — environment template (generated by infrabyx-env example; do not edit by hand)
# IPB-11 v1.0. Secrets (sens:S) MUST be secret:// references in staging/demo/pre-prod/prod/dr.
############################################################

# ---------- APP_ ----------
APP_ENV=local                                  # Deployment environment · req:all · sens:C
APP_PRODUCT=LD                                 # The product this instance of the template stands in for (events, seeds, personas) · req:opt · sens:C
APP_BASE_URL=https://api.example.test          # Canonical origin of the API (the OIDC redirect URI is <origin>/auth/callback) · req:all · sens:C
APP_WEB_URL=https://app.example.test           # Origin of the web app the browser returns to after sign-in; the API's own origin when unset · req:opt · sens:C
APP_PORT=3000                                  # Listening port (the image sets PORT for its HEALTHCHECK; both default to 3000) · req:opt · sens:C
APP_FIXTURE_ADAPTERS=true                      # Fixture IDENTITY, AUTHZ, STORAGE and QUEUE adapters; refused from staging upwards · req:opt · sens:C

# ---------- DB_ ----------
DB_URL=postgres://app@localhost:5432/product   # PostgreSQL URL of the platform database (read through the kernel as app_rw) · req:all · sens:C

# ---------- AUTH_ ----------
AUTH_BASE_URL=https://id.example.test          # Keycloak base URL (without /realms/<realm>) · req:opt · sens:C
AUTH_REALM=infrabyx-local                      # Keycloak realm · req:opt · sens:C
AUTH_CLIENT_ID=reference-api                   # The API's OIDC client (authorisation code with PKCE) · req:opt · sens:C
AUTH_CLIENT_SECRET=secret://vault/identity/keycloak#client_secret # Secret of the API client · req:opt · sens:S
AUTH_ADMIN_CLIENT_ID=reference-admin           # Service account the adapter uses for the Admin API · req:opt · sens:C
AUTH_ADMIN_CLIENT_SECRET=secret://vault/identity/keycloak#admin_client_secret # Secret of the admin service account · req:opt · sens:S
AUTH_AUDIENCE=reference-api                    # Audience the API accepts (`aud`) · req:opt · sens:C

# ---------- AUTHZ_ ----------
AUTHZ_CERBOS_URL=https://cerbos.internal:3592  # Cerbos PDP address · req:opt · sens:C

# ---------- STORAGE_ ----------
STORAGE_ENDPOINT=https://minio.internal:9000   # S3 endpoint (MinIO locally); AWS S3 when unset · req:opt · sens:C
STORAGE_REGION=ap-south-1                      # Bucket region (ap-south-1 or ap-south-2) · req:opt · sens:C
STORAGE_BUCKET_PREFIX=ipb-local                # Bucket name prefix: <prefix>-<class> per bucket class · req:opt · sens:C
STORAGE_ACCESS_KEY=ipb-local                   # Access key id (MinIO) · req:opt · sens:C
STORAGE_SECRET_KEY=secret://vault/storage/minio#secret_key # Secret access key (MinIO) · req:opt · sens:S

# ---------- QUEUE_ ----------
QUEUE_REDIS_URL=secret://vault/queue/redis#url # Redis URL of the BullMQ queues (carries the AUTH password) · req:opt · sens:S

# ---------- SECRETS_ ----------
SECRETS_VAULT_ADDR=https://vault.internal:8200 # Vault or OpenBao address the secret:// references resolve against (staging and above) · req:opt · sens:C
SECRETS_VAULT_ROLE=reference-api               # Kubernetes auth role of this workload · req:opt · sens:C
SECRETS_VAULT_MOUNT=secret                     # KV v2 mount (default secret) · req:opt · sens:C
