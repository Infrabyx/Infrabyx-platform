{
  "name": "@infrabyx/reference-web",
  "version": "0.0.0",
  "description": "Reference web app on Next.js 16 (PL6 plan §8.1): the browser's only origin, a backend-for-frontend over @infrabyx/reference-api, and the gate journey the products copy as apps/web",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "start": "next start",
    "dev": "next dev --webpack",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@infrabyx/cms": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/ui": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/a11y": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1"
  }
}
