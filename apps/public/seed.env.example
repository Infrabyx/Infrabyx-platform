############################################################
# Infrabyx <PRODUCT> — environment template (generated by infrabyx-env example; do not edit by hand)
# IPB-11 v1.0. Secrets (sens:S) MUST be secret:// references in staging/demo/pre-prod/prod/dr.
############################################################

# ---------- SEED_ ----------
SEED_GROUP_ENTITY_NAME=Example Group Private Limited # Legal entity name of the group · req:opt · sens:C
SEED_GROUP_CIN=U00000DL2026PTC000000           # CIN of the group entity (placeholder in dev and test) · req:opt · sens:C
SEED_GROUP_GSTIN=07AAAAA0000A0Z0               # GSTIN of the group entity (placeholder in dev and test) · req:opt · sens:C
SEED_GROUP_REGISTERED_OFFICE=1 Example Road, New Delhi 110001, India # Registered office, one line · req:opt · sens:C
SEED_GROUP_GRIEVANCE_NAME=Example Officer      # Grievance Officer's name · req:opt · sens:C
SEED_GROUP_GRIEVANCE_EMAIL=grievance@example.org # Grievance Officer's email · req:opt · sens:C
SEED_GROUP_DPO_NAME=Example Officer            # Data Protection Officer's name · req:opt · sens:C
SEED_GROUP_DPO_EMAIL=dpo@example.org           # Data Protection Officer's email · req:opt · sens:C
SEED_GROUP_PHONE=+91 11 0000 0000              # Contact phone · req:opt · sens:C
SEED_GROUP_EMAIL=hello@example.org             # Contact email · req:opt · sens:C
SEED_GROUP_STATUS_URL=https://status.example.org # Status page URL (https) · req:opt · sens:C
SEED_GROUP_SOCIAL_URL=https://social.example.org/infrabyx # The group's social profile URL (https) · req:opt · sens:C
SEED_GROUP_OFFICE_DELHI=1 Example Road|New Delhi|110001 # Delhi office: up to four address lines and the PIN, separated by | · req:opt · sens:C
SEED_GROUP_OFFICE_NOIDA=2 Example Avenue|Sector 1, Noida|201301 # Noida office: up to four address lines and the PIN, separated by | · req:opt · sens:C
SEED_GROUP_OFFICE_JAIPUR=3 Example Marg|Jaipur|302001 # Jaipur office: up to four address lines and the PIN, separated by | · req:opt · sens:C
SEED_GROUP_HOSTS=group.example.org             # Comma-separated hosts the group pack serves (the first is primary) · req:opt · sens:C
