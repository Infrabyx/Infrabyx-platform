############################################################
# Infrabyx <PRODUCT> — environment template (generated by infrabyx-env example; do not edit by hand)
# IPB-11 v1.0. Secrets (sens:S) MUST be secret:// references in staging/demo/pre-prod/prod/dr.
############################################################

# ---------- APP_ ----------
APP_ENV=local                                  # Deployment environment · req:all · sens:C
APP_BASE_URL=https://group.example.org         # Canonical https origin of the site (sitemap, canonical links, security.txt) · req:all · sens:C
APP_BRAND_PRODUCT=GRP                          # Brand product whose default pack the site serves when the host is not mapped · req:opt · sens:C
APP_FIXTURE_ADAPTERS=true                      # Use the fixture CRM, HR, OH desk and trust feed; refused from staging upwards · req:opt · sens:C

# ---------- DB_ ----------
DB_URL=postgres://app@localhost:5432/group     # PostgreSQL URL of the platform database (read through the kernel as app_rw) · req:all · sens:C

# ---------- STORAGE_ ----------
STORAGE_DIR=.storage                           # Directory storage for brand and media files; local, dev, test and preview only · req:opt · sens:C
