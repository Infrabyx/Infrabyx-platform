{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["NODE_AUTH_TOKEN", "TURBO_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "vitest.config.*"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "package.json",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/infra/policy/eslint/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "$TURBO_ROOT$/tsconfig.base.json"]
    }
  }
}
