@infrabyx:registry=https://npm.pkg.github.com
engine-strict=true
auto-install-peers=true
node-linker=isolated
# Registry credentials are NOT set here. pnpm 10 refuses to expand ${...} in a committed
# project .npmrc (ADR-0002). CI gets the token from actions/setup-node (registry-url +
# NODE_AUTH_TOKEN, written to a user-level .npmrc); developers run
#   pnpm config set "//npm.pkg.github.com/:_authToken" <token>
