{
  "name": "infrabyx-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Infrabyx shared platform packages implementing the Infrabyx Platform Baseline Standard (IPB) v1.0",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.1",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "ipb:check": "node scripts/ipb-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.14.0",
    "@types/node": "^24.0.0"
  }
}
