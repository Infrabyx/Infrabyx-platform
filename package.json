{
  "name": "infrabyx-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Infrabyx shared platform packages implementing the Infrabyx Platform Baseline Standard (IPB) v1.0",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.1",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "ipb:check": "node scripts/ipb-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "eslint": "9.39.5",
    "@types/node": "24.19.2"
  }
}
