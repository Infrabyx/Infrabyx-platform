{
  "name": "infrabyx-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Infrabyx shared platform packages implementing the Infrabyx Platform Baseline Standard (IPB) v1.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:policy": "vitest run infra/policy packages/testing/eslint",
    "lint": "turbo run lint && eslint scripts infra/policy packages/testing/eslint eslint.config.mjs vitest.shared.mjs",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "ipb:check": "node scripts/ipb-check.mjs",
    "commitlint": "commitlint",
    "licence:check": "node scripts/licence-check.mjs",
    "pr:checklist": "node scripts/pr-checklist.mjs",
    "test:int": "turbo run test:int",
    "migration:lint": "node packages/testing/dist/migration-lint/cli.js packages/tenancy/migrations packages/audit/migrations packages/config/migrations packages/seed/migrations packages/connectors/migrations packages/rules/migrations packages/workflow/migrations packages/notify/migrations",
    "at:report": "node packages/testing/dist/at-report/cli.js --root packages --spec docs/ipb",
    "env:example:check": "node packages/config/dist/env/cli.js example --schema packages/seed/dist/cli.js --export seedEnvSchema --out packages/seed/.env.example --check",
    "registry:check": "pnpm --filter @infrabyx/config check:registry",
    "routing:check": "node packages/config/dist/routing/cli.js check infra/routing/reference/local.routing.yaml infra/routing/reference/ci.routing.yaml --sandbox-status packages/connectors/sandbox-status.json",
    "notify:lint": "node packages/notify/dist/lint-cli.js",
    "dev-keys:check": "pnpm --filter @infrabyx/crypto dev-keys --check"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
