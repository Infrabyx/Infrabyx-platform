{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "24.22.1"
    },
    {
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    }
  ]
}
