[
 {
  "id": "C01",
  "family": "Capital and leverage",
  "ratio": "Capital to risk-weighted assets ratio (CRAR)",
  "computation": "(Tier 1 + Tier 2 capped at Tier 1) / risk-weighted assets",
  "numerator": "{t1}+MIN({t2},{t1})",
  "denominator": "{rwa}",
  "limit_type": "Minimum",
  "limit": 0.15,
  "applies_when": "OR(Setup.$B$7<>\"Base Layer\",Setup.$B$10=\"Yes\")",
  "reference": "Capital Adequacy Directions (MD 345), para 6(1) and 6(3)"
 },
 {
  "id": "C02",
  "family": "Capital and leverage",
  "ratio": "Tier 1 capital ratio",
  "computation": "Tier 1 capital / risk-weighted assets",
  "numerator": "{t1}",
  "denominator": "{rwa}",
  "limit_type": "Minimum",
  "limit": "=IF('Setup'!$B$10=\"Yes\",0.12,0.10)",
