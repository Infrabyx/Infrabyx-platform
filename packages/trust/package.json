{
  "name": "@infrabyx/trust",
  "version": "1.0.0",
  "description": "The vendor-assurance mirror (Operations Hub is the system of record), the tenant Vendor Assurance Room (list, NDA, acknowledgements, requests, subscriptions), the public Trust Centre data, security.txt and the acknowledgement purge (IPB-08; Ecosystem §6.34)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/trust"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@infrabyx/ai": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/testing": "workspace:*"
  }
}
