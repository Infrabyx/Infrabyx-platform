{
  "name": "@infrabyx/crypto",
  "version": "0.1.0",
  "description": "The only cryptography call-site; crypto-agility layer",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-kms": {
      "types": "./dist/local-kms.d.ts",
      "default": "./dist/local-kms.js"
    }
  },
  "files": [
    "dist",
    "dev-keys.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "cbom": "node scripts/cbom.mjs",
    "dev-keys": "node scripts/dev-keys.mjs"
  },
  "dependencies": {
    "@infrabyx/contracts": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/crypto"
  },
  "engines": {
    "node": "24.22.1"
  }
}
