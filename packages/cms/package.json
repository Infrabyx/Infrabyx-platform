{
  "name": "@infrabyx/cms",
  "version": "1.1.13",
  "description": "Headless CMS: content items with immutable revisions, the publish state machine and approvals, the Claims Register, sanitiser, slugs and redirects, SEO and generated files, preview, scheduler, public read API and footer validator (IPB-04 §04.3.1)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sanitise": {
      "types": "./dist/sanitise.d.ts",
      "default": "./dist/sanitise.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "claims",
    "policies",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/cms"
  },
  "engines": {
    "node": "24.22.1"
  },
  "bin": {
    "infrabyx-cms": "./dist/cli.js"
  },
  "dependencies": {
    "@infrabyx/brand": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@infrabyx/ui": "workspace:*",
    "parse5": "8.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/seed": "workspace:*",
    "@infrabyx/testing": "workspace:*"
  }
}
