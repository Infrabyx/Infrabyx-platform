{
  "name": "@infrabyx/connectors",
  "version": "0.0.0",
  "description": "Vendor adapters behind the IPB-01 ports (one folder per port) and the provider_routing runtime",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./feature-flag": {
      "types": "./dist/feature-flag/index.d.ts",
      "default": "./dist/feature-flag/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "default": "./dist/secrets/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "test:contract": "node scripts/contract.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/connectors"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "3.1152.0",
    "@aws-sdk/client-kms": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "unleash-client": "6.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
