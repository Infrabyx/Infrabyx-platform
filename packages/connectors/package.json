{
  "name": "@infrabyx/connectors",
  "version": "0.0.0",
  "description": "Vendor adapters behind the IPB-01 ports (one folder per port) and the provider_routing runtime",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./feature-flag": {
      "types": "./dist/feature-flag/index.d.ts",
      "default": "./dist/feature-flag/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "default": "./dist/secrets/index.js"
    },
    "./kms": {
      "types": "./dist/kms/index.d.ts",
      "default": "./dist/kms/index.js"
    },
    "./authz": {
      "types": "./dist/authz/index.d.ts",
      "default": "./dist/authz/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./workflow/worker": {
      "types": "./dist/workflow/worker.d.ts",
      "default": "./dist/workflow/worker.js"
    },
    "./policy/*": "./policy/*"
  },
  "files": [
    "dist",
    "migrations",
    "policy",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "test:contract": "node scripts/contract.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/connectors"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "3.1152.0",
    "@aws-sdk/client-kms": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@cerbos/http": "0.30.1",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@openfga/sdk": "0.9.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/proto": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "bullmq": "6.3.17",
    "ioredis": "6.0.0",
    "pg-boss": "12.38.0",
    "unleash-client": "6.12.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
