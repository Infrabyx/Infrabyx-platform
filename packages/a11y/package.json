{
  "name": "@infrabyx/a11y",
  "version": "0.1.0",
  "description": "Journey registry and lint, WCAG 2.2 to EN 301 549 mapping, release checklist, accessibility statement generator, hooks, Playwright gate helpers and overlay scan (IPB-06)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "infrabyx-a11y": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "default": "./dist/playwright/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./mapping.json": "./mapping.json",
    "./checklist.md": "./checklist.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "mapping.json",
    "checklist.md",
    "at-scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/a11y"
  },
  "engines": {
    "node": "24.22.1"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.1",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@infrabyx/contracts": "workspace:*",
    "axe-core": "4.14.0",
    "html_codesniffer": "2.5.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
