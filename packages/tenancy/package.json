{
  "name": "@infrabyx/tenancy",
  "version": "1.2.0",
  "description": "Tenant/entity context, RLS helpers, RLS lint",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    },
    "./rls-lint": {
      "types": "./dist/rls-lint/index.d.ts",
      "default": "./dist/rls-lint/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "infrabyx-migrate": "./dist/migrate/cli.js",
    "infrabyx-rls-lint": "./dist/rls-lint/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "mask.rules.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "drizzle-orm": "0.45.4",
    "@nestjs/common": "^11.2.7",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "@nestjs/common": "11.2.7",
    "rxjs": "7.8.2",
    "reflect-metadata": "0.2.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/tenancy"
  },
  "engines": {
    "node": "24.22.1"
  }
}
