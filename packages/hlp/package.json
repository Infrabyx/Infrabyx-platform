{
  "name": "@infrabyx/hlp",
  "version": "0.1.0",
  "description": "Glossary registry and \"i\" popover content, public glossary, hlp-lint and onboarding tours (IPB-07)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "infrabyx-hlp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./registry/*": "./registry/*"
  },
  "files": [
    "dist",
    "registry",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/hlp"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
