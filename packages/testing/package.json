{
  "name": "@infrabyx/testing",
  "version": "1.0.8",
  "description": "Port contract tests, Testcontainers helpers, NN test harness",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint/index.mjs",
    "./migration-lint": {
      "types": "./dist/migration-lint/index.d.ts",
      "default": "./dist/migration-lint/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "infrabyx-migration-lint": "./dist/migration-lint/cli.js",
    "infrabyx-at-report": "./dist/at-report/cli.js"
  },
  "files": [
    "dist",
    "eslint",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/seed": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "libpg-query": "18.1.5",
    "pg": "8.23.1",
    "testcontainers": "12.2.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "eslint": "^10.13.0",
    "vitest": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": "24.22.1"
  }
}
