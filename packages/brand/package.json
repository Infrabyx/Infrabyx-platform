{
  "name": "@infrabyx/brand",
  "version": "1.0.14",
  "description": "Brand packs, Brand Studio with maker-checker publish and rollback, contrast guard, SVG sanitiser, favicon set, host map and terminology (IPB-04 §04.3.2)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/brand"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@infrabyx/ui": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/seed": "workspace:*",
    "@infrabyx/testing": "workspace:*"
  }
}
