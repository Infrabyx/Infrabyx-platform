{
  "name": "@infrabyx/ai",
  "version": "1.0.1",
  "description": "The AI Gateway: model registry, data-class routing that fails closed, prompt registry, guardrails, metering, kill switches and the LLM, EMBEDDING and IMAGE_GEN gateways (IPB-03)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "infrabyx-ai": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "prompts",
    "evals",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "ai:prompt-lint": "node dist/cli.js prompt-lint --root ../..",
    "ai:eval": "node dist/cli.js eval"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/ai"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/seed": "workspace:*",
    "@infrabyx/testing": "workspace:*",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/pg": "8.23.1"
  }
}
