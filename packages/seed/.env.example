############################################################
# Infrabyx <PRODUCT> — environment template (generated by infrabyx-env example; do not edit by hand)
# IPB-11 v1.0. Secrets (sens:S) MUST be secret:// references in staging/demo/pre-prod/prod/dr.
############################################################

# ---------- APP_ ----------
APP_ENV=local                                  # Deployment environment · req:all · sens:C
APP_PRODUCT=LDC                                # Product code LD|LDC|EQ|FBX|UDF|OH · req:all · sens:C

# ---------- SEED_ ----------
SEED_ENABLED=true                              # Must be false/unset in prod/dr/pre-prod · req:opt · sens:C
SEED_LOAD_CONFIRM=                             # Set to yes for the load profile · req:opt · sens:C
SEED_RANDOM_SEED=20261025                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./SEED_CREDENTIALS.md    # Output path (gitignored) · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/ldc/local/seed # Seed vault path · req:nonprod · sens:C

# ---------- DB_ ----------
DB_URL=postgres://app@localhost:5432/ldc       # PostgreSQL URL without password · req:all · sens:C
DB_PASSWORD=app                                # PostgreSQL password · req:all · sens:S
