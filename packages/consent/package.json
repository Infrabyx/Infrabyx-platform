{
  "name": "@infrabyx/consent",
  "version": "1.0.7",
  "description": "The cookie CMP (server-rendered banner and preference centre, first-party controller), consent texts, the consent ledger behind the CONSENT port, the acceptance ledger, script gating and the consent purge (IPB-04 §04.3.9)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/consent"
  },
  "engines": {
    "node": "24.22.1"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "dependencies": {
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "@infrabyx/ui": "workspace:*"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/testing": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
