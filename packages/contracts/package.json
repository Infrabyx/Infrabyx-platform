{
  "name": "@infrabyx/contracts",
  "version": "1.3.0",
  "description": "Port interfaces, Zod schemas, event-catalogue types",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data-class": {
      "types": "./dist/data-class.d.ts",
      "default": "./dist/data-class.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "default": "./dist/ids.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./tiers": {
      "types": "./dist/tiers.d.ts",
      "default": "./dist/tiers.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./modules": {
      "types": "./dist/modules.d.ts",
      "default": "./dist/modules.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./connector-manifest": {
      "types": "./dist/connector-manifest.d.ts",
      "default": "./dist/connector-manifest.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    },
    "./vidhi": {
      "types": "./dist/vidhi.d.ts",
      "default": "./dist/vidhi.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/contracts"
  },
  "engines": {
    "node": "24.22.1"
  }
}
