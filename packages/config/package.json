{
  "name": "@infrabyx/config",
  "version": "1.0.1",
  "description": "Settings registry, tiers, typed env schema loader (exit code 78 on failure)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./flags": {
      "types": "./dist/flags/index.d.ts",
      "default": "./dist/flags/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "default": "./dist/routing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "infrabyx-env": "./dist/env/cli.js",
    "infrabyx-routing": "./dist/routing/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "settings-tree.yaml",
    "flags.defaults.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "gen:registry": "node scripts/gen-registry.mjs",
    "check:registry": "node scripts/gen-registry.mjs --check"
  },
  "dependencies": {
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/config"
  },
  "engines": {
    "node": "24.22.1"
  }
}
