{
  "name": "@infrabyx/vidhi",
  "version": "1.0.13",
  "description": "Vidhi AI kernel: skills, tasks and approvals, autonomy L0–L4 with product ceilings, the immutable locked-action list, persona and reserved advice (IPB-03); missions, schedules, MCP and notebooks follow",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "infrabyx-vidhi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "persona",
    "evals",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "INFRABYX_TEST_INT=1 vitest run --passWithNoTests"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infrabyx/infrabyx-platform.git",
    "directory": "packages/vidhi"
  },
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@infrabyx/ai": "workspace:*",
    "@infrabyx/config": "workspace:*",
    "@infrabyx/contracts": "workspace:*",
    "@infrabyx/crypto": "workspace:*",
    "@infrabyx/tenancy": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@infrabyx/audit": "workspace:*",
    "@infrabyx/connectors": "workspace:*",
    "@infrabyx/seed": "workspace:*",
    "@infrabyx/testing": "workspace:*"
  }
}
