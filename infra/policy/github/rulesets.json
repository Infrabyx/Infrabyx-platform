{
  "$comment": "IPB-09 \u00a709.4.1.4 target rulesets for Infrabyx/Infrabyx-platform. Policy file of record; the live GitHub ruleset is reconciled against it (nightly job, PL6). Deferred until the organisation is on GitHub Team (PL0-D-07): rulesets are not enforceable on private repositories under the Free plan; the owner is upgrading to Team (PL2-D-12).",
  "rulesets": [
    {
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/heads/main"],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "required_linear_history"
        },
        {
          "type": "required_signatures"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": false,
            "allowed_merge_methods": ["squash", "rebase"]
          },
          "$comment": "PL2-D-12: no approving review until a second reviewer exists (GitHub does not let the author approve their own PR; Claude PRs are opened under the owner's account). Raise to 1 with code-owner review when a second reviewer joins. Linear history means squash or rebase merges."
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "verify (24.22.1)"
              },
              {
                "context": "consumer-smoke"
              }
            ]
          },
          "$comment": "IPB-09-07 names ~20 checks; each is added to this list as its job lands (PL1 rls-lint/migration-lint, PL2 contract, PL5 e2e/a11y/lighthouse, PL6 sbom/zap/export-map-gate/golden-archive-diff)."
        }
      ],
      "$comment": "PL2-D-12 (owner, 26 Oct 2026): apply after the GitHub Team upgrade with checks, signed commits and linear history only. Merge queue is left out: it is not available for private repositories on GitHub Team."
    },
    {
      "name": "release-branches",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/heads/release/*"],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "creation",
          "$comment": "creation restricted to the release job identity (bypass actor added when the release job app exists)"
        },
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "required_linear_history"
        },
        {
          "type": "required_signatures"
        },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 1,
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": true,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "allowed_merge_methods": ["squash", "rebase"]
          }
        }
      ]
    },
    {
      "name": "release-tags",
      "target": "tag",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/tags/v*"],
          "exclude": []
        }
      },
      "rules": [
        {
          "type": "creation"
        },
        {
          "type": "update"
        },
        {
          "type": "deletion"
        }
      ]
    },
    {
      "name": "branch-naming",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["~ALL"],
          "exclude": ["refs/heads/main"]
        }
      },
      "rules": [
        {
          "type": "branch_name_pattern",
          "parameters": {
            "operator": "regex",
            "pattern": "^(feat|fix|hotfix)/[A-Za-z0-9._-]+-[a-z0-9-]+$|^release/[0-9]+\\.[0-9]+$|^(chore|docs)/[a-z0-9-]+$|^cc/[a-z0-9]+-[a-z0-9-]+$|^claude/[a-z0-9-]+$|^changeset-release/main$|^renovate/[A-Za-z0-9._/-]+$",
            "negate": false,
            "name": "IPB-09-02 branch names (+ claude/*, changeset-release/main, renovate/* for tooling)"
          }
        }
      ]
    }
  ]
}
