# The local stack (infra/compose, pnpm dev:up; DEV-LOCAL-01, R1-D-290): every variable dev:up, the
# migrations and the dev seeds read or pass. No values here, ever. pnpm dev:up writes the secrets to
# infra/compose/.env.local on first run (never committed, IPB-02-28) and computes the rest from the
# root package.json's `infrabyx` block; the seeded personas' passwords go only to the git-ignored
# SEED_CREDENTIALS.md. Seeds never run when APP_ENV is prod, dr or pre-prod.

# ---------- Generated by dev:up into .env.local (local-only secrets) ----------
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
UNLEASH_DB_PASSWORD=
UNLEASH_ADMIN_TOKEN=
UNLEASH_CLIENT_TOKEN=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=
OPENSEARCH_ADMIN_PASSWORD=
LIVEKIT_API_SECRET=

# ---------- Written to .env.local once the realm is applied ----------
AUTH_CLIENT_SECRET=
AUTH_ADMIN_CLIENT_SECRET=

# ---------- Host ports: default + the product's block; set one in .env.local to move it ----------
PG_PORT=                # 55432 + offset
REDIS_PORT=             # 56379 + offset
MINIO_PORT=             # 59000 + offset
MAILPIT_SMTP_PORT=      # 51025 + offset
MAILPIT_UI_PORT=        # 58025 + offset
KEYCLOAK_PORT=          # 58080 + offset
TEMPORAL_PORT=          # 57233 + offset
TEMPORAL_UI_PORT=       # 58233 + offset
GOTENBERG_PORT=         # 53000 + offset
UNLEASH_PORT=           # 54242 + offset
CERBOS_PORT=            # 53592 + offset
LIVEKIT_PORT=           # 57880 + offset
LIVEKIT_RTC_TCP_PORT=   # 57881 + offset
OPENSEARCH_PORT=        # 59200 + offset
OLLAMA_PORT=            # 51434 + offset
GRAFANA_PORT=           # 53300 + offset
OTLP_GRPC_PORT=         # 54317 + offset
OTLP_HTTP_PORT=         # 54318 + offset
# Each declared app: <NAME>_PORT (53120 + slot + offset), e.g. WEB_PORT, API_PORT

# ---------- Passed by dev:up to the migrations and the dev seeds (computed, never set here) ----------
APP_ENV=
APP_PRODUCT=
APP_BASE_URL=
APP_FIXTURE_ADAPTERS=
DB_URL=
DB_PASSWORD=
STORAGE_DIR=
SEED_ENABLED=
SEED_RANDOM_SEED=
SEED_VAULT_PREFIX=
SEED_CREDENTIALS_PATH=
AUTH_BASE_URL=
AUTH_REALM=
AUTH_CLIENT_ID=
AUTH_ADMIN_CLIENT_ID=
AUTH_AUDIENCE=
AUTHZ_CERBOS_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET_PREFIX=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
QUEUE_REDIS_URL=
WORKFLOW_TEMPORAL_ADDRESS=
